{
  "name": "@synth/neuronwaves",
  "version": "0.1.0",
  "description": "Synth platform cognitive planning system",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "bin": {
    "synth": "dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:cli",
    "build:lib": "tsdown src/index.ts --format esm --dts --clean",
    "build:cli": "tsdown src/cli/index.ts --format esm --dts --clean --outDir dist/cli",
    "test": "vitest run",
    "dev": "vitest",
    "lint": "echo \"No lint configured\""
  },
  "devDependencies": {
    "tsdown": "^0.20.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "keywords": ["synth", "neuronwaves", "planning"],
  "author": "Synthium-Systema",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Itslouisbaby/Synthium-Systema.git"
  }
}