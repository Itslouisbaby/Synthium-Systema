{
  "name": "@synth/neuronwaves",
  "version": "1.0.0",
  "description": "Synth platform cognitive planning system",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "bin": {
    "synth": "dist/cli/index.mjs",
    "synth-tui": "dist/tui/index.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:cli && npm run build:tui",
    "build:lib": "tsdown src/index.ts --format esm --dts --clean",
    "build:cli": "tsdown src/cli/index.ts --format esm --dts --clean --outDir dist/cli",
    "build:tui": "tsdown src/tui/entry.tsx --format esm --dts --clean --outDir dist/tui",
    "tui": "node dist/tui/entry.mjs",
    "setup": "node dist/cli/index.mjs setup",
    "test": "vitest run",
    "dev": "vitest",
    "lint": "echo \"No lint configured\""
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.6.2",
    "ink": "^5.2.1",
    "ink-big-text": "^2.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stdout-update": "^4.0.1"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "tsdown": "^0.20.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "keywords": [
    "synth",
    "neuronwaves",
    "planning"
  ],
  "author": "Synthium-Systema",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Itslouisbaby/Synthium-Systema.git"
  }
}